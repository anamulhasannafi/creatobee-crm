# ==============================================================================
# CREATo BEE — ADVANCED BUSINESS MANAGEMENT SYSTEM (.env.example)
# Copy this file to .env and configure values for your target hosting environment.
# NEVER commit real database passwords, session secrets, or private keys to git.
# ==============================================================================

# 1. Runtime & Network Configuration
NODE_ENV=production
PORT=3000
APP_URL=https://erp.example.com
NEXT_PUBLIC_APP_URL=https://erp.example.com

# 2. Relational Database Connection (PostgreSQL 14+)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://creatobee_user:CHANGE_THIS_STRONG_PASSWORD@127.0.0.1:5432/creatobee_erp

# 3. Authentication & Session Security
# Generate a 64-character hex string using: openssl rand -hex 32
SESSION_SECRET=replace_with_a_64_character_cryptographic_random_secret_string_here
AUTH_SESSION_TTL_HOURS=168
# Set COOKIE_SECURE=true when deployed behind HTTPS (cPanel SSL / Nginx / Cloudflare)
COOKIE_SECURE=auto
# Set TRUST_PROXY=true when running behind Nginx, Apache, or cPanel Phusion Passenger
TRUST_PROXY=true

# 4. File Uploads & Persistent Storage Compatibility
# Relative or absolute writable path outside ephemeral build directories
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10

# 5. Timezone & Accounting Defaults
TZ=Asia/Dhaka
APP_TIMEZONE=Asia/Dhaka
DEFAULT_BASE_CURRENCY=USD
DEFAULT_USD_TO_BDT_RATE=121.50
